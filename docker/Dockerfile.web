# ============================================================================
# WEB FRONTEND DOCKERFILE - SIMPLIFIED & OPTIMIZED FOR AKS
# ============================================================================
# Multi-stage build to keep image small (~50MB)
# Stages: 1) Build React app with Vite, 2) Serve with Nginx

# Stage 1: Build React application
FROM node:20-alpine AS builder

# Enable pnpm
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

# Copy workspace files
COPY package.json pnpm-workspace.yaml ./
COPY packages/web/package.json ./packages/web/package.json

# Install all dependencies (including dev for build)
RUN pnpm install --frozen-lockfile=false

# Copy source code
COPY packages/web ./packages/web

# Build React app with Vite
RUN pnpm --filter @ecommerce/web build

# ============================================================================
# Stage 2: Serve with Nginx (minimal production image)
FROM nginx:1.27-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1000 appuser && adduser -D -u 1000 -G appuser appuser

# Copy nginx configuration
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf

# Copy entrypoint script
COPY docker/entrypoint-web.sh /entrypoint-web.sh
RUN chmod +x /entrypoint-web.sh

# Copy built React app from builder stage
COPY --from=builder /app/packages/web/dist /usr/share/nginx/html

# Copy environment template script
COPY docker/env.template.js /usr/share/nginx/html/env.template.js

# Create nginx cache/temp directories with correct permissions
RUN mkdir -p /var/cache/nginx /var/run/nginx && \
    chown -R appuser:appuser /var/cache/nginx /var/run/nginx /etc/nginx

# Set nginx to run as unprivileged user
RUN sed -i 's/user nginx;/user appuser;/' /etc/nginx/nginx.conf

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Start nginx
ENTRYPOINT ["/entrypoint-web.sh"]
CMD ["nginx", "-g", "daemon off;"]
