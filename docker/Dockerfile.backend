# ============================================================================
# BACKEND DOCKERFILE - SIMPLIFIED & OPTIMIZED FOR AKS
# ============================================================================
# Multi-stage build to keep image small (~150MB)
# Stages: 1) Dependencies, 2) Build, 3) Production

# Stage 1: Install dependencies
FROM node:20-alpine AS dependencies
RUN apk add --no-cache curl
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

# Copy workspace files
COPY package.json pnpm-workspace.yaml ./
COPY packages/backend/package.json ./packages/backend/package.json

# Install dependencies for backend only
RUN pnpm install --filter @ecommerce/backend... --prod --frozen-lockfile=false

# ============================================================================
# Stage 2: Build application
FROM dependencies AS builder

# Copy source code
COPY packages/backend ./packages/backend

# Build TypeScript to JavaScript
RUN pnpm --filter @ecommerce/backend build

# ============================================================================
# Stage 3: Production runtime (minimal image)
FROM node:20-alpine

# Set environment
ENV NODE_ENV=production
ENV LOG_LEVEL=info

# Create non-root user for security
RUN addgroup -g 1000 appuser && adduser -D -u 1000 -G appuser appuser

# Set working directory
WORKDIR /app

# Copy only necessary files from builder
COPY --from=dependencies /app/node_modules /app/node_modules
COPY --from=builder /app/packages/backend/dist ./dist
COPY --from=builder /app/packages/backend/package.json ./package.json

# Copy .env.example as template
COPY packages/backend/.env.example ./.env.example

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:3000/health/live || exit 1

# Start application
CMD ["node", "dist/index.js"]
