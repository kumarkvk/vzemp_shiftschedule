{
  "name": "@ecommerce/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready ecommerce Express backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage --runInBand",
    "db:migrate": "db-migrate up --config ./db-migrate-config.js --migrations-dir ./migrations",
    "db:rollback": "db-migrate down --config ./db-migrate-config.js --migrations-dir ./migrations --count 1",
    "db:status": "db-migrate check --config ./db-migrate-config.js --migrations-dir ./migrations",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "db-migrate reset --config ./db-migrate-config.js --migrations-dir ./migrations && npm run db:migrate && npm run db:seed",
    "db:create:migration": "db-migrate create --config ./db-migrate-config.js --migrations-dir ./migrations",
    "db:test:prepare": "tsx src/scripts/prepare-test-db.ts",
    "db:test:cleanup": "tsx src/scripts/cleanup-test-db.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "stripe": "^17.1.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.0",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
