  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "^11.0.15",
    "detox": "^20.21.2",
    "eslint": "^8.57.1",
