    "test:e2e:headed": "playwright test --headed",
    "analyze": "cross-env ANALYZE=true vite build"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.8.0",
    "@stripe/stripe-js": "^4.5.0",
